# Postgres connection used by the app and Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/superhighway

# Use your public HTTPS URL in production.
APP_URL=http://localhost:3000
# Domain verified with SES, with MX records pointing to SES receiving.
MAIL_DOMAIN=agents.example.com
SYSTEM_FROM=highway@agents.example.com

# Generate once with: openssl rand -base64 32
# Keep this key backed up; replacing it makes existing archives unreadable.
MESSAGE_KEY=

# SES sending region and application credentials with ses:SendEmail.
# The app also needs s3:GetObject and s3:DeleteObject for inbound mail.
SES_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket used by your SES receipt rule's S3 action.
INBOUND_BUCKET=your-inbound-mail-bucket
INBOUND_BUCKET_REGION=us-east-1
# Pin the SNS topic configured on that S3 action.
INBOUND_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:your-inbound-topic

# Optional Google sign-in. Register APP_URL/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
